{
  "hooks": {
    "SessionStart": [{
      "matcher": "*",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ensure-claude-md-gates.sh",
        "timeout": 5
      }, {
        "type": "prompt",
        "prompt": "Twining MCP tools are available. CLAUDE.md contains the \"Twining Lifecycle Gates\" — follow them. Your FIRST tool call MUST be `twining_assemble` with your task and scope. Do not read files or make changes until assemble returns."
      }]
    }],
    "SubagentStop": [{
      "matcher": "*",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop-hook.sh",
        "timeout": 10
      }]
    }],
    "Stop": [{
      "matcher": "*",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-hook.sh",
        "timeout": 10
      }]
    }]
  }
}
