{
  "hooks": {
    "SessionStart": [{
      "matcher": "*",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/ensure-claude-md-gates.sh",
        "timeout": 5
      }, {
        "type": "prompt",
        "prompt": "Twining MCP tools are available. Two gates: (1) `twining_assemble` FIRST — before reading code. (2) `twining_record` LAST — before committing or ending. See CLAUDE.md \"Twining Lifecycle Gates\" for details."
      }]
    }],
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-hook.sh",
        "timeout": 5
      }]
    }],
    "Stop": [{
      "matcher": "*",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/stop-hook.sh",
        "timeout": 10
      }]
    }],
    "SubagentStop": [{
      "matcher": "*",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subagent-stop-hook.sh",
        "timeout": 10
      }]
    }]
  }
}
